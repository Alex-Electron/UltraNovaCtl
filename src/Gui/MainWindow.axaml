<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UltraNovaCtl.Gui.MainWindow"
        Title="UltraNovaCtl" Width="1120" Height="720"
        MinWidth="900" MinHeight="620"
        Background="#0C0C10"
        Icon="/icon.ico">

  <Window.Styles>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#7A7A8A"/>
      <Setter Property="Margin" Value="2,0,0,6"/>
    </Style>
    <Style Selector="Button.tool">
      <Setter Property="Background" Value="#1A1A21"/>
      <Setter Property="BorderBrush" Value="#2C2C36"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TextBlock.stat">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="#8A8A9A"/>
    </Style>
    <Style Selector="TextBlock.statval">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="#D0D0DC"/>
      <Setter Property="Margin" Value="4,0,18,0"/>
    </Style>

    <!-- One look for every input, so a dropdown does not read differently to a field. -->
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#101015"/>
      <Setter Property="BorderBrush" Value="#2C2C36"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Foreground" Value="#DCDCE6"/>
      <Setter Property="SelectionBrush" Value="#3A4A5E"/>
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#141419"/>
      <Setter Property="BorderBrush" Value="#3A3A46"/>
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#141419"/>
      <Setter Property="BorderBrush" Value="#F5A524"/>
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="Background" Value="#101015"/>
      <Setter Property="BorderBrush" Value="#2C2C36"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Foreground" Value="#DCDCE6"/>
      <Setter Property="Padding" Value="8,0"/>
    </Style>
    <Style Selector="ComboBox /template/ Border#Background">
      <Setter Property="Background" Value="#101015"/>
      <Setter Property="BorderBrush" Value="#2C2C36"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#Background">
      <Setter Property="Background" Value="#141419"/>
      <Setter Property="BorderBrush" Value="#3A3A46"/>
    </Style>
    <Style Selector="ComboBox:focus /template/ Border#Background">
      <Setter Property="BorderBrush" Value="#F5A524"/>
    </Style>
    <Style Selector="ComboBoxItem">
      <Setter Property="FontFamily" Value="Consolas,monospace"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="8,4"/>
    </Style>
  </Window.Styles>

  <DockPanel>

    <!-- One toolbar row. Automap connected/not lives in the window title, not here. -->
    <Border DockPanel.Dock="Top" Background="#15151B" BorderBrush="#24242C"
            BorderThickness="0,0,0,1" Padding="10,6">
      <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,Auto" VerticalAlignment="Center">
        <TextBlock Grid.Column="0" Text="MIDI out" Classes="stat"
                   VerticalAlignment="Center" Margin="0,0,6,0"/>
        <ComboBox Grid.Column="1" Name="PortBox" MinWidth="80" FontSize="12"
                  HorizontalAlignment="Stretch"
                  ToolTip.Tip="Where the mapped controls are sent. A virtual port such as loopMIDI is what a DAW listens to."/>
        <TextBlock Grid.Column="2" Text="Learn in" Classes="stat"
                   VerticalAlignment="Center" Margin="12,0,6,0"
                   ToolTip.Tip="Port to listen on while learning: the interface a foreign synth is plugged into"/>
        <ComboBox Grid.Column="3" Name="InPortBox" MinWidth="80" FontSize="12"
                  HorizontalAlignment="Stretch"/>
        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                    Margin="6,0,0,0">
          <Button Name="TestBtn" Classes="tool" Content="Test" Width="52"
                  FontSize="11"
                  ToolTip.Tip="Send CC 21 to the output, value 127 then 0. If a monitor sees it but the DAW does not, the DAW must reconnect - that cannot be done from here."/>
          <Button Name="ReinitBtn" Classes="tool" Content="Reinit" Width="62"
                  Margin="6,0,0,0" FontSize="11"
                  ToolTip.Tip="Reopen the MIDI ports and redraw the synth. Use if the DAW stopped receiving, or after the synth was replugged."/>
          <Button Name="RescanBtn" Classes="tool" Content="&#x21BB;" Width="34"
                  Margin="6,0,0,0" FontSize="14"
                  ToolTip.Tip="Rescan MIDI devices - use after plugging an interface in"/>
          <Border Name="LearnBadge" Background="#2A2416" BorderBrush="#F5A524"
                  BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="10,0,0,0"
                  IsVisible="False">
            <TextBlock Text="LEARN" FontSize="11" FontWeight="Bold" Foreground="#F5A524"/>
          </Border>
          <TextBlock Text="Learn" Classes="stat" VerticalAlignment="Center" Margin="10,0,6,0"/>
          <ComboBox Name="LearnBox" Width="86" Height="30" FontSize="12"
                    VerticalContentAlignment="Center"
                    ToolTip.Tip="Watches the Learn in port and copies what a foreign device sends onto the selected control. On does it once and switches off; Latch keeps going."/>
        </StackPanel>
        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center"
                    Margin="10,0,0,0" Spacing="6">
          <Button Name="SaveBtn" Classes="tool" Content="Save" Width="66"
                  ToolTip.Tip="Save to the working configuration used at startup"/>
          <Button Name="ExportBtn" Classes="tool" Content="Export" Width="70"
                  ToolTip.Tip="Write these mappings to a file"/>
          <Button Name="ImportBtn" Classes="tool" Content="Import" Width="70"
                  ToolTip.Tip="Load mappings from a file"/>
          <Button Name="ConnectBtn" Classes="tool" Content="USB" Width="44" FontSize="11"
                  Opacity="0.55"
                  ToolTip.Tip="USB host session. The app keeps this open on its own. Window title is Automap, not this."/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- synth state strip, mirrors the header of the original editor -->
    <Border DockPanel.Dock="Top" Background="#101016" BorderBrush="#20202A"
            BorderThickness="0,0,0,1" Padding="12,6">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="Kbd ch" Classes="stat" VerticalAlignment="Center"/>
        <ComboBox Name="KbdChBox" Width="64" Height="26" FontSize="11"
                  FontFamily="Consolas,monospace" VerticalContentAlignment="Center"/>

        <TextBlock Text="Octave" Classes="stat" VerticalAlignment="Center" Margin="10,0,0,0"/>
        <ComboBox Name="OctaveBox" Width="64" Height="26" FontSize="11"
                  FontFamily="Consolas,monospace" VerticalContentAlignment="Center"/>

        <TextBlock Text="Transpose" Classes="stat" VerticalAlignment="Center" Margin="10,0,0,0"/>
        <ComboBox Name="TransposeBox" Width="64" Height="26" FontSize="11"
                  FontFamily="Consolas,monospace" VerticalContentAlignment="Center"/>

        <TextBlock Text="Aftertouch" Classes="stat" VerticalAlignment="Center" Margin="10,0,0,0"/>
        <ComboBox Name="AfterBox" Width="106" Height="26" FontSize="11"
                  VerticalContentAlignment="Center"/>

        <TextBlock Text="Mode" Classes="stat" VerticalAlignment="Center" Margin="14,0,0,0"/>
        <TextBlock Name="ModeText" Classes="statval" VerticalAlignment="Center" Text="-"/>
      </StackPanel>
    </Border>

    <!-- banks and pages, selected here or by the panel's own mode buttons -->
    <Border DockPanel.Dock="Top" Background="#0E1116" BorderBrush="#20202A"
            BorderThickness="0,0,0,1" Padding="12,7">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto">
        <StackPanel Name="BankTabs" Grid.Column="0" Orientation="Horizontal" Spacing="4"/>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
          <TextBlock Text="Page" Classes="stat" VerticalAlignment="Center"/>
          <TextBlock Name="PageText" Classes="statval" VerticalAlignment="Center"
                     Margin="2,0,6,0" Text="1/1"/>
        </StackPanel>
        <Button Name="PagePrevBtn" Grid.Column="3" Classes="tool" Content="&#x2039;" Width="34"
                ToolTip.Tip="Previous page. Same as PAGE&#x2039; on the synth, whose lamp lights only when there is somewhere to go."/>
        <Button Name="PageNextBtn" Grid.Column="4" Classes="tool" Content="&#x203A;"
                Width="34" Margin="4,0,0,0"
                ToolTip.Tip="Next page. Same as PAGE&#x203A; on the synth."/>
        <Button Name="PageAddBtn" Grid.Column="5" Classes="tool" Content="+ page"
                Width="70" Margin="10,0,0,0"
                ToolTip.Tip="Add a page to this bank. Ten knobs per page, as many pages as you like."/>
        <Button Name="PageDelBtn" Grid.Column="6" Classes="tool" Content="&#x2212; page"
                Width="70" Margin="6,0,0,0"
                ToolTip.Tip="Remove the current page"/>
      </Grid>
    </Border>

    <!-- Selected control name is compact on the left; the tabs use the rest. -->
    <Border DockPanel.Dock="Top" Background="#15151B" BorderBrush="#24242C"
            BorderThickness="0,0,0,1" Padding="12,8">
      <Grid ColumnDefinitions="Auto,*">

        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0" MaxWidth="168">
          <TextBlock Name="SelName" FontSize="15" FontWeight="SemiBold"
                     Foreground="#F5C87A" TextWrapping="Wrap" Text="nothing selected"/>
          <TextBlock Name="SelBinding" Classes="stat" TextWrapping="Wrap"
                     Text="click a knob or button"/>
          <TextBlock Name="SelValue" FontSize="13" FontFamily="Consolas,monospace"
                     Foreground="#D0D0DC" Text=""/>
        </StackPanel>

        <TabControl Grid.Column="1" Name="EditTabs" Padding="0">

          <TabItem Header="Parameter" FontSize="12">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*" Margin="0,8,0,0">
              <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Label" Classes="stat" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Name="SelLabel" Width="112" MaxLength="8" FontSize="12" Height="30"
                         VerticalContentAlignment="Center" Padding="8,0"/>
              </StackPanel>

              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Text="Sends" Classes="stat" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Name="SelSend" Width="168" FontSize="12" Height="30"
                          ToolTip.Tip="What this control sends. Disabled silences it and shows a dash on the synth display."
                          VerticalContentAlignment="Center"/>
              </StackPanel>

              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Text="Ch" Classes="stat" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Name="SelChannel" Width="62" FontSize="12" Height="30"
                          ToolTip.Tip="MIDI channel. Different channels let one bank drive several instruments at once."
                          FontFamily="Consolas,monospace" VerticalContentAlignment="Center"/>
              </StackPanel>

              <Grid Grid.Column="3" ColumnDefinitions="Auto,*" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Grid.Column="0" Name="NumberLabel" Text="Number" Classes="stat"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Grid.Column="1" Name="SelTransport" MinWidth="120" FontSize="12" Height="30"
                          VerticalContentAlignment="Center" IsVisible="False"
                          HorizontalAlignment="Stretch"
                          ToolTip.Tip="Real-time messages drive a sequencer slaved to external clock; MMC is remote control of a DAW's own transport. Which works depends on the software."/>
                <TextBox Grid.Column="1" Name="SelKey" MinWidth="120" FontSize="12" Height="30"
                         FontFamily="Consolas,monospace" VerticalContentAlignment="Center"
                         Padding="8,0" IsVisible="False" Watermark="click here and press the keys"
                         HorizontalAlignment="Stretch"
                         ToolTip.Tip="Click the field and press the combination. It is sent to whatever window has focus."/>
                <ComboBox Grid.Column="1" Name="SelPick" MinWidth="120" FontSize="12" Height="30"
                          FontFamily="Consolas,monospace" VerticalContentAlignment="Center"
                          HorizontalAlignment="Stretch"
                          ToolTip.Tip="Type while the list is open to jump to an entry"/>
                <TextBox Grid.Column="1" Name="SelNumber" IsVisible="False" Width="88"
                         FontFamily="Consolas,monospace" VerticalContentAlignment="Center"
                         HorizontalAlignment="Left"/>
              </Grid>
            </Grid>
          </TabItem>

          <TabItem Name="TouchTab" Header="Touch" FontSize="12">
            <Grid RowDefinitions="Auto,Auto" Margin="0,8,0,0">
              <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*">
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="On touch" Classes="stat" VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <ComboBox Name="TouchSend" Width="168" FontSize="12" Height="30"
                            ToolTip.Tip="What a finger landing on this knob sends, separately from turning it. Off by default."
                            VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                  <TextBlock Text="Ch" Classes="stat" VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <ComboBox Name="TouchChannel" Width="62" FontSize="12" Height="30"
                            FontFamily="Consolas,monospace" VerticalContentAlignment="Center"/>
                </StackPanel>
                <Grid Grid.Column="2" ColumnDefinitions="Auto,*" VerticalAlignment="Center" Margin="12,0,0,0">
                  <TextBlock Grid.Column="0" Name="TouchNumberLabel" Text="CC" Classes="stat"
                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <ComboBox Grid.Column="1" Name="TouchTransport" MinWidth="120" FontSize="12" Height="30"
                            VerticalContentAlignment="Center" IsVisible="False"
                            HorizontalAlignment="Stretch"
                            ToolTip.Tip="Real-time messages drive a sequencer slaved to external clock; MMC is remote control of a DAW's own transport."/>
                  <TextBox Grid.Column="1" Name="TouchKey" MinWidth="120" FontSize="12" Height="30"
                           FontFamily="Consolas,monospace" VerticalContentAlignment="Center"
                           Padding="8,0" IsVisible="False" Watermark="click here and press the keys"
                           HorizontalAlignment="Stretch"
                           ToolTip.Tip="Click the field and press the combination. It is sent to whatever window has focus."/>
                  <ComboBox Grid.Column="1" Name="TouchPick" MinWidth="120" FontSize="12" Height="30"
                            FontFamily="Consolas,monospace" VerticalContentAlignment="Center"
                            HorizontalAlignment="Stretch"/>
                  <TextBox Grid.Column="1" Name="TouchNumber" IsVisible="False" Width="88"
                           FontFamily="Consolas,monospace" VerticalContentAlignment="Center"
                           HorizontalAlignment="Left"/>
                </Grid>
              </Grid>
              <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                <TextBlock Text="Released" Classes="stat" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Name="TouchOff" Width="58" FontSize="12" Height="30"
                         ToolTip.Tip="Sent when the finger leaves"
                         FontFamily="Consolas,monospace" VerticalContentAlignment="Center"
                         HorizontalContentAlignment="Center" Padding="4,0"/>
                <TextBlock Text="Touched" Classes="stat" VerticalAlignment="Center" Margin="12,0,6,0"/>
                <TextBox Name="TouchOn" Width="58" FontSize="12" Height="30"
                         ToolTip.Tip="Sent when the finger lands"
                         FontFamily="Consolas,monospace" VerticalContentAlignment="Center"
                         HorizontalContentAlignment="Center" Padding="4,0"/>
                <ComboBox Name="TouchMode" Width="120" FontSize="12" Height="30" Margin="12,0,0,0"
                          VerticalContentAlignment="Center"
                          ToolTip.Tip="Momentary follows the finger. Toggle alternates on each touch."/>
              </StackPanel>
            </Grid>
          </TabItem>

          <TabItem Header="Range" FontSize="12">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*" Margin="0,8,0,0">
              <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Name="FromLabel" Text="From" Classes="stat" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Name="SelFrom" Width="58" FontSize="12" Height="30"
                         ToolTip.Tip="Lowest value sent, or what a released switch sends. Set it above the other field to reverse the control."
                         FontFamily="Consolas,monospace" VerticalContentAlignment="Center"
                         HorizontalContentAlignment="Center" Padding="4,0"/>
              </StackPanel>

              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <TextBlock Name="ToLabel" Text="To" Classes="stat" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Name="SelTo" Width="58" FontSize="12" Height="30"
                         ToolTip.Tip="Highest value sent, or what a pressed switch sends."
                         FontFamily="Consolas,monospace" VerticalContentAlignment="Center"
                         HorizontalContentAlignment="Center" Padding="4,0"/>
              </StackPanel>

              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <TextBlock Text="Mode" Classes="stat" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Name="SelMode" Width="176" FontSize="12" Height="30"
                          VerticalContentAlignment="Center"
                          ToolTip.Tip="Knobs: Normal sends a position; Relative sends the movement instead, so the control never hits an end. Four relative encodings exist and they disagree - pick the one your software expects. Switches: Momentary follows the press, Normal is a plain 127/0 switch, Toggle alternates, Step walks through positions."/>

                <TextBlock Name="PointsLabel" Text="Points" Classes="stat"
                           VerticalAlignment="Center" Margin="14,0,6,0"/>
                <TextBox Name="SelPoints" Width="52" FontSize="12" Height="30"
                         ToolTip.Tip="How many positions Step walks through, spread evenly across the range. Five points over 0-127 give 0, 32, 64, 95, 127."
                         FontFamily="Consolas,monospace" VerticalContentAlignment="Center"
                         HorizontalContentAlignment="Center" Padding="4,0"/>
                <TextBlock Name="StepSizeText" Classes="stat" VerticalAlignment="Center"
                           Margin="8,0,0,0" Text=""/>
              </StackPanel>

              <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                          Margin="16,0,0,0">
                <CheckBox Name="SelPickupBox" Content="Pickup" FontSize="11"
                          IsChecked="True" IsVisible="False"
                          ToolTip.Tip="After a bank or page change, do not send until the physical position matches the last value sent on this page. Off: send the current position immediately. Wheels and pedals only."/>
                <TextBlock Classes="stat" VerticalAlignment="Center" Margin="16,0,0,0"
                           Text="From above To inverts the control. Toggle latches a button."/>
              </StackPanel>
            </Grid>
          </TabItem>

        </TabControl>
      </Grid>
    </Border>

    <!-- content over log, with a divider that can be dragged -->
    <Grid RowDefinitions="*,Auto,120">

      <Grid.Styles>
        <Style Selector="GridSplitter">
          <Setter Property="Background" Value="#1A1A21"/>
          <Setter Property="Height" Value="5"/>
        </Style>
        <Style Selector="GridSplitter:pointerover">
          <Setter Property="Background" Value="#F5A524"/>
        </Style>
      </Grid.Styles>

      <ScrollViewer Grid.Row="0">
      <StackPanel Margin="14,12">

        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,0,0,6">
          <TextBlock Grid.Column="0" Classes="section" Text="ENCODERS" Margin="2,0,0,0"
                     VerticalAlignment="Center"/>
          <Button Name="ResetBtn" Grid.Column="2" Classes="tool" Content="Zero all"
                  Width="80" FontSize="11" Padding="8,3" Margin="0,0,6,0"
                  ToolTip.Tip="Set every encoder value back to zero. Assignments are left alone."/>
          <Button Name="ClearBtn" Grid.Column="3" Classes="tool" Content="Clear"
                  Width="70" FontSize="11" Padding="8,3" Margin="0,0,6,0"
                  ToolTip.Tip="Remove every assignment on this bank, all pages. Navigation still works. Encoder values stay."/>
          <Button Name="RevertBtn" Grid.Column="4" Classes="tool" Content="Revert"
                  Width="74" FontSize="11" Padding="8,3"
                  ToolTip.Tip="Restore this page to the factory map for this bank."/>
        </Grid>
        <Border Background="#111117" CornerRadius="6" BorderBrush="#20202A"
                BorderThickness="1" Padding="10,12">
          <WrapPanel Name="EncoderRow" Orientation="Horizontal"/>
        </Border>

        <TextBlock Classes="section" Text="WHEELS &amp; PEDALS" Margin="2,16,0,6"/>
        <Border Background="#111117" CornerRadius="6" BorderBrush="#20202A"
                BorderThickness="1" Padding="10">
          <WrapPanel Name="AnalogWrap" Orientation="Horizontal"/>
        </Border>

        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,16,0,6">
          <TextBlock Grid.Column="0" Classes="section" Text="BUTTONS" Margin="2,0,0,0"
                     VerticalAlignment="Center"/>
          <CheckBox Grid.Column="2" Name="EchoLedsBox" Content="Light buttons when pressed"
                    FontSize="11" IsChecked="True" VerticalAlignment="Center"
                    ToolTip.Tip="Echo a press on the button's own lamp. Only buttons up to code 34 have one; VALUE and SELECT do not."/>
        </Grid>
        <Border Background="#111117" CornerRadius="6" BorderBrush="#20202A"
                BorderThickness="1" Padding="10">
          <WrapPanel Name="ButtonWrap" Orientation="Horizontal"/>
        </Border>


        <Expander Name="DebugLedsExpander" Header="Debug tools" IsExpanded="False"
                  Margin="0,16,0,0" HorizontalAlignment="Stretch" FontSize="12"
                  IsVisible="False">
          <StackPanel Margin="0,6,0,0" Spacing="10">
            <Border Background="#111117" CornerRadius="6" BorderBrush="#20202A"
                    BorderThickness="1" Padding="10,8">
              <StackPanel Spacing="6">
                <TextBlock Classes="stat" TextWrapping="Wrap"
                           Text="LEARN, VIEW, banks and pages still do their jobs. Assign MIDI here and they send that too. Disabled by default."/>
                <WrapPanel Name="DebugAppButtonsWrap" Orientation="Horizontal"/>
              </StackPanel>
            </Border>
            <Border Background="#111117" CornerRadius="6" BorderBrush="#20202A"
                    BorderThickness="1" Padding="10,8">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Code" Classes="stat" VerticalAlignment="Center"/>
                <ComboBox Name="LedCodeBox" Width="180" Height="30" FontSize="12"
                          ToolTip.Tip="Lamp code. Note this numbering is not the same as the button codes above 34 - there are more lamps than buttons."
                          FontFamily="Consolas,monospace" VerticalContentAlignment="Center"/>
                <Button Name="LedOnBtn" Classes="tool" Content="Light" Width="66"
                        ToolTip.Tip="Light this code and look at the synth to see which lamp it is"/>
                <Button Name="LedOffBtn" Classes="tool" Content="Clear" Width="66"
                        ToolTip.Tip="Turn this one off"/>
                <Button Name="LedPrevBtn" Classes="tool" Content="&#x2039;" Width="34" Margin="10,0,0,0"
                        ToolTip.Tip="Previous code, lit"/>
                <Button Name="LedNextBtn" Classes="tool" Content="&#x203A;" Width="34"
                        ToolTip.Tip="Next code, lit - walk a range this way"/>
                <Button Name="LedAllOffBtn" Classes="tool" Content="All off" Width="70" Margin="10,0,0,0"
                        ToolTip.Tip="Clear every lamp. Press a bank button on the synth to bring the navigation lamps back."/>
                <Button Name="DemoBtn" Classes="tool" Content="Demo" Width="70"
                        ToolTip.Tip="20 s panel film (all scenes in one run, at most 13 lamps). Press again to stop."/>
                <TextBox Name="LedNameBox" Width="150" Height="30" FontSize="12" Margin="14,0,0,0"
                         VerticalContentAlignment="Center" Padding="8,0"
                         Watermark="what lit up?"/>
                <Button Name="LedNameBtn" Classes="tool" Content="Name it" Width="80"
                        ToolTip.Tip="Record what this code lights. Saved with the configuration."/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Expander>

      </StackPanel>
    </ScrollViewer>


      <GridSplitter Grid.Row="1" ResizeDirection="Rows" HorizontalAlignment="Stretch"
                    Cursor="SizeNorthSouth"
                    ToolTip.Tip="Drag to make the log taller"/>

      <Border Grid.Row="2" Background="#0A0A0E" Padding="0">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="#0D0D12" Padding="8,4"
                  BorderBrush="#1A1A21" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Log" Classes="stat" VerticalAlignment="Center" Margin="2,0,8,0"/>
              <Button Name="LogCopyBtn" Classes="tool" Content="Copy" Width="58" FontSize="11"
                      Padding="6,2"
                      ToolTip.Tip="Copy the whole log to the clipboard. Text can also be selected with the mouse."/>
              <Button Name="LogSaveBtn" Classes="tool" Content="Save..." Width="66" FontSize="11"
                      Padding="6,2"
                      ToolTip.Tip="Write the log to a text file"/>
              <Button Name="LogClearBtn" Classes="tool" Content="Clear" Width="58" FontSize="11"
                      Padding="6,2"
                      ToolTip.Tip="Empty the log"/>
              <CheckBox Name="LogFollowBox" Content="Follow" FontSize="11" IsChecked="True"
                        VerticalAlignment="Center" Margin="8,0,0,0"
                        ToolTip.Tip="Scroll to newest automatically. Turn off to read without being dragged along."/>
            </StackPanel>
          </Border>

          <ScrollViewer Name="LogScroll" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto" Padding="10,6">
            <SelectableTextBlock Name="LogText" FontFamily="Consolas,monospace" FontSize="11"
                                 TextWrapping="NoWrap" Foreground="#8A8A9A"
                                 SelectionBrush="#2E4257">
              <SelectableTextBlock.ContextMenu>
                <ContextMenu>
                  <MenuItem Name="LogMenuCopySel" Header="Copy selection"
                            InputGesture="Ctrl+C"/>
                  <MenuItem Name="LogMenuCopyAll" Header="Copy whole log"/>
                  <Separator/>
                  <MenuItem Name="LogMenuSave" Header="Save to file..."/>
                  <MenuItem Name="LogMenuClear" Header="Clear"/>
                </ContextMenu>
              </SelectableTextBlock.ContextMenu>
            </SelectableTextBlock>
          </ScrollViewer>
        </DockPanel>
      </Border>

    </Grid>

  </DockPanel>
</Window>
